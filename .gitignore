# Large raw game data; regenerate/use locally, do not commit.
/raw/

# Generated outputs are ignored by default. Curated final text outputs below
# are kept as small, reviewable backups in this repository.
/result/*
!/result/Momotalk/
!/result/Momotalk/Momotalk_message/
!/result/Momotalk/Momotalk_message/**
!/result/scenario/
!/result/scenario/scenario_texts/
!/result/scenario/scenario_texts/**
!/result/bond_story/
!/result/bond_story/bond_story_text/
!/result/bond_story/bond_story_text/**
!/result/free_dialog/
!/result/free_dialog/free_dialog_text/
!/result/free_dialog/free_dialog_text/**

# Local-only combined outputs and generation reports.
/result/Momotalk/*combined*/
/result/Momotalk/*combined*/**
/result/bond_story/*combined*/
/result/bond_story/*combined*/**
/result/**/reports/
/result/**/reports/**
/result/**/*reports/
/result/**/*reports/**

# Python local artifacts.
__pycache__/
*.py[cod]
.venv/
venv/
